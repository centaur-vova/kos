# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WORKER_NUM=8

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=game_shop
DB_USER=app
DB_PASSWORD=secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Providers
PROVIDER_A_HOST=provider-a
PROVIDER_A_PORT=8000
PROVIDER_B_HOST=provider-b
PROVIDER_B_PORT=8000
PROVIDER_TIMEOUT_MS=5000

# Retry
DELIVERY_MAX_RETRIES=3
DELIVERY_RETRY_DELAYS_MS=1000,3000,5000

# Mock provider settings
MOCK_ERROR_RATE_A=20
MOCK_TIMEOUT_RATE_A=10
MOCK_TIMEOUT_DURATION_SEC_A=7
MOCK_ERROR_RATE_B=10
MOCK_TIMEOUT_RATE_B=5
MOCK_TIMEOUT_DURATION_SEC=5

