# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WORKER_NUM=8

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=game_shop
DB_USER=app
DB_PASSWORD=secret

# Providers (JSON config)
PROVIDERS_CONFIG={"A":{"host":"provider-a","port":8000,"timeout_ms":5000},"B":{"host":"provider-b","port":8000,"timeout_ms":5000}}

# Delivery
DELIVERY_LOCK_TTL_SEC=30
DELIVERY_MAX_RETRIES=3
DELIVERY_RETRY_DELAYS_MS=[1000,3000,5000]

# Logging
LOG_LEVEL=info

# Recovery
RECOVERY_INTERVAL_SEC=60
RECOVERY_STUCK_AFTER_MIN=5
RECOVERY_BATCH_SIZE=10

# Payment
PAYMENT_IDEMPOTENCY_TTL_SEC=86400

# Swoole specific settings
SWOOLE_STORAGE_TABLE_SIZE=1024
